{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoSidian",
  "version": "1.1.0",
  "identifier": "app.nosidian.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoSidian",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 520,
        "transparent": false,
        "decorations": false,
        "label": "main",
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' blob: data: https: http:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://open.spotify.com https://w.soundcloud.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost blob: data: https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Knowledge, study, projects and focus studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRTQwMjMzOTVDQkZBOTkKUldTWitzdVZNd0xrdzVjL0xEZ2svOTJNRWlXM3g5cUI3V2t5Mi9FdVZwOVVlbXVLYnZERzRTbmwK",
      "endpoints": [
        "https://github.com/RezaNoel/NoSidian/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
